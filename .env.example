# Environment Variables — Stealth Subtitle Translator
# ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# DeepL API Key (optional — enables highest-quality translations)
# Free key: https://www.deepl.com/pro-api  (suffix :fx for free tier)
DEEPL_API_KEY=your-deepl-api-key-here:fx

# Deepgram API Key (optional — enables real-time cloud streaming via Nova-2)
# Free $200 credit on signup: https://console.deepgram.com/
# ~45,000 minutes / ~750 hours of transcription before any charges
DEEPGRAM_API_KEY=your-deepgram-api-key-here
