{
    "$schema": "https://opencode.ai/config.json",
    "model": "MiniMax-M2.5-highspeed",
    "instructions": [
        "AGENTS.md",
        ".agent/SYSTEM.md",
        ".agent/skills/SKILL_INDEX.md",
        ".agent/rules/100-tech-stack.md"
    ],
    "agent": {
        "build": {
            "mode": "primary",
            "prompt": "You are the Maestro Build Agent. CORE CONSTITUTION: {file:./AGENTS.md}. SYSTEM GUIDE: {file:./.agent/SYSTEM.md}. CRITICAL: You must read these files at the start of EVERY session. Do not act without verification.",
            "tools": {
                "write": true,
                "edit": true,
                "bash": true
            }
        },
        "plan": {
            "mode": "primary",
            "description": "Planlama ve analiz (read-only)",
            "tools": {
                "write": false,
                "edit": false,
                "bash": false
            }
        }
    },
    "command": {
        "verify": {
            "template": "Run python3 scripts/verify_all.py and report results",
            "description": "Maestro do\u011frulama suite'i \u00e7al\u0131\u015ft\u0131r",
            "agent": "build"
        },
        "review": {
            "template": "Review the current codebase following .agent/skills/code-review-checklist/SKILL.md standards",
            "description": "Kod incelemesi yap",
            "agent": "plan"
        }
    },
    "permission": {
        "bash": "allow",
        "edit": "allow",
        "webfetch": "ask"
    }
}