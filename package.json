{
    "name": "stealth-subtitle-translator",
    "version": "1.0.0",
    "description": "Real-time, privacy-focused desktop subtitle translation with stealth overlay",
    "author": "Senol Dogan",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/senoldogann/Live-Translate.git"
    },
    "homepage": "https://github.com/senoldogann/Live-Translate",
    "bugs": {
        "url": "https://github.com/senoldogann/Live-Translate/issues"
    },
    "main": "dist-electron/main.js",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "electron:dev": "vite",
        "electron:build": "npm run build && electron-builder",
        "oss:start": "bash scripts/run_open_source.sh",
        "python:install": "bash scripts/run_open_source.sh --setup-only",
        "python:engine": "source python/.venv/bin/activate && python python/engine.py",
        "start": "npm run electron:dev",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "electron-updater": "^6.8.9",
        "framer-motion": "^11.15.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "zeromq": "^6.6.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.1",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/coverage-v8": "^4.1.11",
        "concurrently": "^10.0.5",
        "electron": "^44.0.0",
        "electron-builder": "^26.15.3",
        "jsdom": "^27.4.0",
        "typescript": "^5.7.2",
        "vite": "^8.2.2",
        "vite-plugin-electron": "^0.28.8",
        "vite-plugin-electron-renderer": "^0.14.6",
        "vitest": "^4.0.16",
        "wait-on": "^9.1.0"
    },
    "build": {
        "appId": "com.stealth.subtitle.translator",
        "productName": "Stealth Subtitle Translator",
        "publish": [
            {
                "provider": "github",
                "owner": "senoldogann",
                "repo": "Live-Translate",
                "releaseType": "draft"
            }
        ],
        "directories": {
            "output": "release"
        },
        "mac": {
            "category": "public.app-category.productivity",
            "icon": "build/icon.icns",
            "target": [
                "dmg"
            ],
            "artifactName": "Stealth-Subtitle-Translator-${version}-${arch}.${ext}",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "extendInfo": {
                "NSMicrophoneUsageDescription": "This app needs access to system audio for transcription."
            }
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*"
        ],
        "extraResources": [
            {
                "from": "python",
                "to": "python",
                "filter": [
                    "**/*",
                    "!**/__pycache__",
                    "!**/.pytest_cache/**",
                    "!**/{test,tests,testing,example,examples,doc,docs}/**",
                    "!**/*.pyc",
                    "!**/*.pyo",
                    "!**/*.pyd",
                    "!**/*.dist-info/RECORD",
                    "!Dockerfile",
                    "!docker-compose.yml",
                    "!requirements-server.txt",
                    "!.venv/bin/pip*",
                    "!.venv/bin/activate*",
                    "!.venv/bin/idle3*",
                    "!.venv/bin/python*-config"
                ]
            }
        ]
    },
    "allowScripts": {
        "electron@38.8.6": true
    }
}
