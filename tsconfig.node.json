{
    "compilerOptions": {
        "composite": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "outDir": "dist-electron",
        "declaration": true,
        "declarationMap": true
    },
    "include": [
        "vite.config.ts",
        "vitest.config.ts",
        "electron/**/*"
    ]
}